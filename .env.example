# Copy to .env. The real environment always wins over this file.
# The language model: bedrock (default) or selfhosted. Any other value turns AI off.
# EB_LLM=bedrock
# Claude on Amazon Bedrock. Unset AWS credentials mean AI is off; the AI switch shows as off and disabled.
EB_MODEL=au.anthropic.claude-haiku-4-5-20251001-v1:0
EB_AWS_REGION=ap-southeast-2
# AWS_BEARER_TOKEN_BEDROCK=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# A self-hosted OpenAI-compatible server, used when EB_LLM=selfhosted. AI is off unless the URL and the key are both set.
# EB_LLM_BASE_URL=https://llm.khmervision.org/v1
# EB_LLM_API_KEY=
# EB_LLM_MODEL=qwen3-4b
# EB_LLM_TIMEOUT_S=10
# KiriTTS speech to text and text to speech. Unset means the mic and speaker are hidden.
KIRITTS_API_KEY=
# Telegram webhook secret (docs/18-telegram.md). Unset means /api/telegram returns 404.
# TELEGRAM_WEBHOOK_SECRET=
# Telegram bot token, to fetch voice messages and show "typing…". Unset means a voice message gets "type your question" and no typing shows.
# TELEGRAM_BOT_TOKEN=
# EB_DB=data/cache.sqlite
# EB_OFFLINE=1
POWER_COMMUNITY=AG
