# Copy to .env. The real environment always wins over this file.
# Claude on Amazon Bedrock. Unset AWS credentials mean AI is off; the AI switch shows as off and disabled.
EB_MODEL=au.anthropic.claude-haiku-4-5-20251001-v1:0
EB_AWS_REGION=ap-southeast-2
# AWS_BEARER_TOKEN_BEDROCK=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# KiriTTS speech to text and text to speech. Unset means the mic and speaker are hidden.
KIRITTS_API_KEY=
# Telegram webhook secret (docs/18-telegram.md). Unset means /api/telegram returns 404.
# TELEGRAM_WEBHOOK_SECRET=
# EB_DB=data/cache.sqlite
# EB_OFFLINE=1
POWER_COMMUNITY=AG
