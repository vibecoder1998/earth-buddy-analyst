# Copy to .env. The real environment always wins over this file.
# Unset means AI is unavailable; the AI switch shows as off and disabled.
# Base URL of an OpenAI-compatible server (Ollama, llama.cpp, vLLM), ending in /v1. `tools/llm-host/llm-host.sh env` prints all three.
EB_LLM_URL=
EB_MODEL=qwen3:8b
# EB_LLM_KEY=
# EB_DB=data/cache.sqlite
# EB_OFFLINE=1
POWER_COMMUNITY=AG
